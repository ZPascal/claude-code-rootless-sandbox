# Claude Code Sandbox - Default Configuration
# Customize these values for your project

# Container image name
SANDBOX_IMAGE_NAME=claude-code-sandbox

# Base image to use (change if you need different OS/packages)
# Supported: ubuntu:24.04, ubuntu:22.04, debian:12, fedora:40, alpine:latest
SANDBOX_BASE_IMAGE=ubuntu:24.04

# CPU limit (empty = no limit)
# Examples: 1, 2, 2.5
SANDBOX_CPUS=

# Memory limit (empty = no limit)
# Examples: 512m, 1g, 2g, 4g
SANDBOX_MEMORY=

# Network mode: host (default), none (no network access), or custom
# host    = full network access (default, for development)
# none    = no network access (for audit/compliance scenarios)
SANDBOX_NETWORK=host

# Mount project as read-only (true/false)
# true  = inspect only, no writes to project files
# false = full read/write access (default)
SANDBOX_READONLY=false

# Enable audit logging (true/false)
# true  = capture all stdout/stderr to audit log
# false = normal output (default)
SANDBOX_AUDIT_LOG=false

# Additional environment variables to pass to the container
# Format: KEY1=VALUE1,KEY2=VALUE2 or single KEY=VALUE
# Examples:
#   SANDBOX_ENV_EXTRA=HTTP_PROXY=http://proxy:8080,HTTPS_PROXY=http://proxy:8080
#   SANDBOX_ENV_EXTRA=PYTHON_VERSION=3.11
SANDBOX_ENV_EXTRA=

# Container runtime (auto-detected if not set)
# podman = preferred (native rootless, no daemon)
# docker = requires Docker rootless mode or daemon running
RUNTIME=

# --- Profiles (uncomment one to use pre-configured settings) ---

# Development Profile (default above)
# Uncomment to explicitly use development settings:
# SANDBOX_NETWORK=host
# SANDBOX_READONLY=false
# SANDBOX_CPUS=
# SANDBOX_MEMORY=

# Audit Profile (read-only, no network, resource-limited)
# Uncomment for compliance/audit scenarios:
# SANDBOX_NETWORK=none
# SANDBOX_READONLY=true
# SANDBOX_CPUS=2
# SANDBOX_MEMORY=4g
# SANDBOX_AUDIT_LOG=true

# Strict Profile (isolated, limited resources)
# Uncomment for maximum security:
# SANDBOX_NETWORK=none
# SANDBOX_READONLY=false
# SANDBOX_CPUS=1
# SANDBOX_MEMORY=2g
# SANDBOX_AUDIT_LOG=true
